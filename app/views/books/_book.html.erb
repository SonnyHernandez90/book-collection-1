<div id="<%= dom_id book %>">
  <p>
    <strong>Title:</strong>
    <%= book.title %>
  </p>

  <p>
    <strong>Author:</strong>
    <%= book.author.presence || "Not provided" %>
  </p>

  <p>
    <strong>Price:</strong>
    <%= book.price.present? ? number_to_currency(book.price) : "Not provided" %>
  </p>

  <p>
    <strong>Published date:</strong>
    <%= book.published_date&.strftime("%B %d, %Y") || "Not provided" %>
  </p>
</div>
